diff --git a/armsrc/Standalone/Makefile.hal b/armsrc/Standalone/Makefile.hal
--- a/armsrc/Standalone/Makefile.hal
+++ b/armsrc/Standalone/Makefile.hal
@@ -168,7 +168,13 @@
         STANDALONE_REQ_DEFS += -DWITH_FLASH
     endif
     ifneq ($(filter $(STANDALONE),$(STANDALONE_MODES_REQ_BT)),)
-        STANDALONE_REQ_DEFS += -DWITH_FPC_USART_HOST
+        # BadgeBunny: with -DCARDHOPPER_USB (USB-CDC) or -DCARDHOPPER_BWM (BLE via BWM),
+        # the relay doesn't need the FPC USART (lets HF_CARDHOPPER build on PLATFORM=PM5).
+        ifeq ($(findstring -DCARDHOPPER_USB,$(STANDALONE_PLATFORM_DEFS)),)
+          ifeq ($(findstring -DCARDHOPPER_BWM,$(STANDALONE_PLATFORM_DEFS)),)
+            STANDALONE_REQ_DEFS += -DWITH_FPC_USART_HOST
+          endif
+        endif
     endif
 else ifneq ($(STANDALONE),)
     $(error Invalid STANDALONE: $(STANDALONE). $(KNOWN_DEFINITIONS))
